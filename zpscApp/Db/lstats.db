
 

############# Lstats (MSG ID 10) #########################



record(ai, "$(P){$(NO)}Rtos-Uptime-I") {
    field(DESC, "RTOS Uptime")
    field(DTYP, "PSC Reg F32")
    field(INP , "@PSC$(NO) 10 0")
    field(SCAN,"I/O Intr")
    field(EGU, "sec")
}

record(longin, "$(P){$(NO)}Rtos-Nthreads-I") {
    field(DESC, "RTOS Number of Threads")
    field(DTYP, "PSC Reg")
    field(INP , "@PSC$(NO) 10 4")
    field(SCAN,"I/O Intr")
}

